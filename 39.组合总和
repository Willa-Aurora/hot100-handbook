"""
【组合总和 - 回溯】

思路（简洁）：
用 DFS 遍历每个候选数，对于每个数有两种选择：不选或选（可重复选）。
维护剩余目标 left，当 left == 0 时记录路径；当 left < 0 或遍历完时返回。

易错点：
1. 可以重复使用同一个数字，选之后递归参数是 i 而不是 i+1。
2. 先判断 left == 0 记录答案，再判断越界或 left < 0 返回。
3. path 需要 copy 后再加入答案。
4. 输入 target 可能为 0，应返回 [[]]。

时空复杂度：
- 时间 O(n * 2^target)，最坏指数级
- 空间 O(target)，递归深度

输入输出示例：
输入:
[2,3,6,7]
7
输出: [[2,2,3],[7]]
"""

import sys
import json
from typing import List


class Solution:
    def combinationSum(self, candidates: List[int], target: int) -> List[List[int]]:
        ans = []
        path = []
        n = len(candidates)

        def dfs(i: int, left: int) -> None:
            if left == 0:
                ans.append(path.copy())
                return
            if i == n or left < 0:
                return
            dfs(i + 1, left)                       # 不选
            path.append(candidates[i])             # 选
            dfs(i, left - candidates[i])
            path.pop()

        dfs(0, target)
        return ans


def main():                                        
    lines = sys.stdin.read().strip().splitlines()
    if len(lines) < 2:
        return
    try:
        candidates = json.loads(lines[0])
        target = int(lines[1])
    except:
        candidates = list(map(int, lines[0].strip('[]').split(',')))
        target = int(lines[1])
    sol = Solution()
    print(json.dumps(sol.combinationSum(candidates, target)))


if __name__ == "__main__":                         
    main()
