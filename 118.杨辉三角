"""
【杨辉三角 - 递推】

思路（简洁）：
先生成一个每行全为 1 的三角形，然后从第 3 行开始（索引 2），
对于每行中间的元素（索引 1 到 i-1），其值等于上一行左上方和正上方元素之和。

易错点：
1. numRows = 0 时返回空列表 []。
2. 每行长度是 i+1，初始化全为 1。
3. 内层循环范围是 range(1, i)，即不包括两端。
4. 输出为二维列表，用 json.dumps 输出标准 JSON。

时空复杂度：
- 时间复杂度 O(numRows^2)，需填充每个元素。
- 空间复杂度 O(numRows^2)，存储结果。

输入输出示例：
示例 1：
输入: 5
输出: [[1],[1,1],[1,2,1],[1,3,3,1],[1,4,6,4,1]]

示例 2：
输入: 1
输出: [[1]]

示例 3：
输入: 0
输出: []
"""

import sys
import json
from typing import List


class Solution:
    def generate(self, numRows: int) -> List[List[int]]:
        # 初始化每行全为 1
        c = [[1] * (i + 1) for i in range(numRows)]
        # 从第 3 行开始计算中间元素
        for i in range(2, numRows):
            for j in range(1, i):
                c[i][j] = c[i - 1][j - 1] + c[i - 1][j]
        return c


def main():
    data = sys.stdin.read().strip()
    if not data:
        return
    try:
        numRows = int(data)
    except:
        # 兼容可能的 JSON 格式或空格分隔
        numRows = int(data.split()[0])
    sol = Solution()
    result = sol.generate(numRows)
    print(json.dumps(result))


if __name__ == "__main__":
    main()
