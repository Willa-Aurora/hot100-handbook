"""
【课程表 - 拓扑排序（BFS + 入度）】

思路（简洁）：
把课程看成节点，先修关系看成有向边（pre -> cur）。
统计每门课的入度，将所有入度为 0 的课入队。
不断出队，把其出边指向的课入度减 1，若减到 0 则入队。
最终统计能出队的课程数，若等于总课程数，说明无环，可以完成。

易错点：
1. 入度数组 indegree 统计的是每门课的“先修课数量”。
2. 边方向：pre -> cur，即先修课指向后续课。
3. 初始入队的是所有入度为 0 的课（没有先修要求）。
4. 每次出队 count++，最后判断 count == numCourses。
5. 需要 from collections import deque。

时空复杂度：
- 时间复杂度 O(V + E)，V 为课程数，E 为先修关系数
- 空间复杂度 O(V + E)，存储图和入度数组

输入输出示例：
示例 1：
输入:
2 [[1,0]]
输出: true

示例 2：
输入:
2 [[1,0],[0,1]]
输出: false

示例 3：
输入:
1 []
输出: true
"""

import sys
import json
from collections import deque
from typing import List


class Solution:
    def canFinish(self, numCourses: int, prerequisites: List[List[int]]) -> bool:
        indegree = [0] * numCourses
        graph = [[] for _ in range(numCourses)]

        # 建图：pre -> cur
        for cur, pre in prerequisites:
            indegree[cur] += 1
            graph[pre].append(cur)

        # 入度为 0 的课程入队
        q = deque([i for i in range(numCourses) if indegree[i] == 0])
        count = 0

        while q:
            node = q.popleft()
            count += 1
            for nxt in graph[node]:
                indegree[nxt] -= 1
                if indegree[nxt] == 0:
                    q.append(nxt)

        return count == numCourses


def main():
    # 输入格式：一行是 numCourses，一行是 prerequisites 数组
    # 例如：2 [[1,0]]
    data = sys.stdin.read().split()
    if len(data) < 2:
        return
    numCourses = int(data[0])
    prerequisites = json.loads(data[1])
    sol = Solution()
    print("true" if sol.canFinish(numCourses, prerequisites) else "false")


if __name__ == "__main__":
    main()
