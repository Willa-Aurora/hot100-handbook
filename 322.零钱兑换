"""
【零钱兑换 - 完全背包（动态规划）】

思路（简洁）：
设 f[c] 表示凑出金额 c 所需的最少硬币数。
初始化 f[0] = 0，其余为无穷大。
遍历每种硬币 x，对容量 c 从 x 到 amount 正向遍历：
    f[c] = min(f[c], f[c - x] + 1)
正向遍历保证每种硬币可以重复使用（完全背包）。

最终 f[amount] 若仍为无穷大，则无法凑出，返回 -1。

易错点：
1. 初始化：f[0] = 0，其他为 inf。
2. 内层循环必须从 x 到 amount 正向遍历，才能重复选同一硬币。
3. 返回时判断 ans < inf，否则返回 -1。
4. amount = 0 时直接返回 0。
5. 硬币数组可能为空，但不影响。

时空复杂度：
- 时间复杂度 O(n * amount)，n 为硬币种类数
- 空间复杂度 O(amount)

输入输出示例：
示例 1：
输入:
[1,2,5]
11
输出: 3

示例 2：
输入:
[2]
3
输出: -1

示例 3：
输入:
[1]
0
输出: 0
"""

import sys
import json
from math import inf
from typing import List


class Solution:
    def coinChange(self, coins: List[int], amount: int) -> int:
        f = [0] + [inf] * amount
        for x in coins:
            for c in range(x, amount + 1):
                f[c] = min(f[c], f[c - x] + 1)
        ans = f[amount]
        return ans if ans < inf else -1


def main():
    data = sys.stdin.read().split()
    if len(data) < 2:
        return
    # 第一个 token 是硬币数组，第二个 token 是目标金额
    coins = json.loads(data[0])
    amount = int(data[1])
    sol = Solution()
    print(sol.coinChange(coins, amount))


if __name__ == "__main__":
    main()
