"""
【爬楼梯 - 动态规划】

思路（简洁）：
设 dp[i] 为到达第 i 阶的方法数。由于每次可以爬 1 或 2 阶，
因此 dp[i] = dp[i-1] + dp[i-2]，即斐波那契数列。
初始：dp[1] = 1, dp[2] = 2。从 3 开始递推。

易错点：
1. n = 0 时返回 0（但题目通常 n >= 1）。
2. n = 1 返回 1，n = 2 返回 2。
3. 使用数组存储，空间 O(n)；也可用两个变量优化到 O(1)。
4. 注意 dp 数组下标从 1 开始，大小为 n+1。

时空复杂度：
- 时间复杂度 O(n)
- 空间复杂度 O(n)（可优化为 O(1)）

输入输出示例：
示例 1：
输入: 2
输出: 2

示例 2：
输入: 3
输出: 3

示例 3：
输入: 1
输出: 1
"""

import sys
import json


class Solution:
    def climbStairs(self, n: int) -> int:
        if n == 0:
            return 0
        if n == 1:
            return 1
        if n == 2:
            return 2
        dp = [0] * (n + 1)
        dp[1] = 1
        dp[2] = 2
        for i in range(3, n + 1):
            dp[i] = dp[i - 1] + dp[i - 2]
        return dp[n]


def main():
    data = sys.stdin.read().strip()
    if not data:
        return
    # 输入可能为纯数字或带引号的 JSON 数字
    try:
        n = int(data)
    except:
        # 兼容空格分隔或 JSON 格式
        n = int(data.split()[0])
    sol = Solution()
    result = sol.climbStairs(n)
    print(result)


if __name__ == "__main__":
    main()
