"""
【下一个排列 - 双指针 + 原地反转】

思路（简洁）：
1. 从右向左找到第一个满足 nums[i] < nums[i+1] 的位置 i。
2. 若 i 存在，从右向左找到第一个大于 nums[i] 的位置 j，交换 nums[i] 和 nums[j]。
3. 反转 nums[i+1:]（若 i 不存在，则 i = -1，相当于反转整个数组）。

易错点：
1. 第一步的循环条件是 nums[i] >= nums[i+1]，找到的是第一个“升序对”的左端。
2. 第二步找 j 时，条件为 nums[j] <= nums[i]，确保找到严格大于 nums[i] 的最右元素。
3. 如果 i < 0，跳过第二步，直接反转整个数组。
4. 反转后缀必须原地进行，不能用切片赋值（会额外占用 O(n) 空间）。
5. 函数原地修改，无返回值。

时空复杂度：
- 时间复杂度 O(n)，最多扫描两遍 + 反转一遍
- 空间复杂度 O(1)，原地交换

输入输出示例：
示例 1：
输入: [1,2,3]
输出: [1,3,2]

示例 2：
输入: [3,2,1]
输出: [1,2,3]

示例 3：
输入: [1,1,5]
输出: [1,5,1]
"""

import sys
import json
from typing import List


class Solution:
    def nextPermutation(self, nums: List[int]) -> None:
        n = len(nums)

        # 第一步：从右到左找到第一个小于 nums[i+1] 的数 nums[i]
        i = n - 2
        while i >= 0 and nums[i] >= nums[i + 1]:
            i -= 1

        # 如果找到了，进入第二步；否则跳过第二步，反转整个数组
        if i >= 0:
            # 第二步：从右到左找到 nums[i] 右边最小的大于 nums[i] 的数 nums[j]
            j = n - 1
            while nums[j] <= nums[i]:
                j -= 1
            # 交换 nums[i] 和 nums[j]
            nums[i], nums[j] = nums[j], nums[i]

        # 第三步：反转 nums[i+1:]（如果上面跳过第二步，此时 i = -1）
        left, right = i + 1, n - 1
        while left < right:
            nums[left], nums[right] = nums[right], nums[left]
            left += 1
            right -= 1


def main():
    data = sys.stdin.read().split()
    if not data:
        return
    nums = json.loads(data[0])
    sol = Solution()
    sol.nextPermutation(nums)
    print(json.dumps(nums))


if __name__ == "__main__":
    main()
