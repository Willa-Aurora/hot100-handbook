"""
【划分字母区间 - 贪心 + 哈希表】

思路（简洁）：
先记录每个字符最后出现的下标 last[c]。
遍历字符串，维护当前片段的右边界 end = max(end, last[c])。
当遍历下标 i == end 时，说明当前片段内的所有字符都不会再出现在后面，
该片段结束，记录长度 end - start + 1，并更新 start = end + 1。

易错点：
1. last 字典存储每个字符最后出现的下标。
2. end 必须动态取最大值，不能只看当前字符的最后位置。
3. 切分条件是 i == end，切分后 start 更新为 end + 1。
4. 输入 s 可能带 JSON 引号，需要兼容处理。

时空复杂度：
- 时间复杂度 O(n)，一次遍历
- 空间复杂度 O(1)，字符集大小固定（26个小写字母）

输入输出示例：
示例 1：
输入: "ababcbacadefegdehijhklij"
输出: [9,7,8]

示例 2：
输入: "eccbbbbdec"
输出: [10]

示例 3：
输入: "abc"
输出: [1,1,1]
"""

import sys
import json
from typing import List


class Solution:
    def partitionLabels(self, s: str) -> List[int]:
        # 记录每个字符最后出现的位置
        last = {c: i for i, c in enumerate(s)}
        ans = []
        start = end = 0
        for i, c in enumerate(s):
            end = max(end, last[c])      # 扩展当前片段右边界
            if end == i:                 # 当前片段结束
                ans.append(end - start + 1)
                start = end + 1
        return ans


def main():
    data = sys.stdin.read().strip()
    if not data:
        return
    # 兼容输入带引号（JSON 字符串）或裸字符串
    try:
        s = json.loads(data)
    except:
        s = data
    sol = Solution()
    print(json.dumps(sol.partitionLabels(s)))


if __name__ == "__main__":
    main()
