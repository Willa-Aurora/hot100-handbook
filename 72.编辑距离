"""
【编辑距离 - 记忆化搜索（DP）】

思路（简洁）：
dfs(i, j) 表示将 word1 的前 i 个字符转换成 word2 的前 j 个字符所需的最少操作数。
- i == 0：word1 为空，只能插入 j 个字符，返回 j。
- j == 0：word2 为空，只能删除 i 个字符，返回 i。
- 若 word1[i-1] == word2[j-1]：末尾相同，无需操作，返回 dfs(i-1, j-1)。
- 否则：取三种操作的最小值 +1：
    插入：dfs(i, j-1)
    删除：dfs(i-1, j)
    替换：dfs(i-1, j-1)

用 @cache 记忆化，避免重复子问题。

易错点：
1. 递归参数是长度（i, j），不是下标，所以边界是 i == 0 / j == 0。
2. 比较字符时用 word1[i-1] 和 word2[j-1]。
3. 三种操作分别对应插入、删除、替换，别漏掉或写错顺序。
4. @cache 需要 Python 3.9+；低版本用 @lru_cache(None)。
5. 输入字符串可能带 JSON 引号，需兼容处理。

时空复杂度：
- 时间复杂度 O(m * n)，m、n 分别为两个字符串长度。
- 空间复杂度 O(m * n)，记忆化缓存所有状态。

输入输出示例：
示例 1：
输入: horse ros
输出: 3

示例 2：
输入: intention execution
输出: 5

示例 3：
输入: abc abc
输出: 0
"""

import sys
from functools import cache


class Solution:
    def minDistance(self, word1: str, word2: str) -> int:
        @cache
        def dfs(i: int, j: int) -> int:
            # 情况1：word1 空了，只能插入 j 个字符
            if i == 0:
                return j
            # 情况2：word2 空了，只能删除 i 个字符
            if j == 0:
                return i
            # 情况3：末尾相同，不用操作，两个都退一格
            if word1[i - 1] == word2[j - 1]:
                return dfs(i - 1, j - 1)
            # 情况4：末尾不同，三种操作取最小 +1
            return min(
                dfs(i, j - 1),      # 插入：word2 退一格
                dfs(i - 1, j),      # 删除：word1 退一格
                dfs(i - 1, j - 1)   # 替换：两个都退一格
            ) + 1

        return dfs(len(word1), len(word2))


def main():
    # 输入两个字符串，空格或换行分隔，如：horse ros
    data = sys.stdin.read().split()
    if len(data) < 2:
        return
    word1 = data[0].strip('"')
    word2 = data[1].strip('"')
    sol = Solution()
    print(sol.minDistance(word1, word2))


if __name__ == "__main__":
    main()
