"""
【最长递增子序列 - 贪心 + 二分查找（耐心排序）】

思路（简洁）：
维护一个数组 tails，tails[i] 表示长度为 i+1 的递增子序列的最小结尾元素。
遍历每个 num，用二分查找在 tails[0..res) 中找到第一个 >= num 的位置 i，
将 tails[i] = num。若 i == res，说明找到了更长的子序列，res++。

tails 数组本身严格递增，因此可以二分。

易错点：
1. 二分查找的是第一个 >= num 的位置（左闭右开区间 [0, res)）。
2. 更新 tails[i] = num 后，若 i == res，则 res++。
3. 注意判断条件是 j == res（二分结束后 i == j），表示 num 比 tails 中所有元素都大。
4. tails 初始化为长度 len(nums) 的数组，实际有效长度为 res。
5. 输入可能为空数组，返回 0。

时空复杂度：
- 时间复杂度 O(n log n)，每个元素二分 O(log n)
- 空间复杂度 O(n)，tails 数组

输入输出示例：
示例 1：
输入: [10,9,2,5,3,7,101,18]
输出: 4

示例 2：
输入: [0,1,0,3,2,3]
输出: 4

示例 3：
输入: [7,7,7,7,7]
输出: 1
"""

import sys
import json
from typing import List


class Solution:
    def lengthOfLIS(self, nums: List[int]) -> int:
        tails = [0] * len(nums)
        res = 0
        for num in nums:
            i, j = 0, res
            # 二分查找第一个 >= num 的位置
            while i < j:
                m = (i + j) // 2
                if tails[m] < num:
                    i = m + 1
                else:
                    j = m
            tails[i] = num
            if j == res:          # num 比所有 tails 都大，子序列变长
                res += 1
        return res


def main():
    data = sys.stdin.read().split()
    if not data:
        return
    nums = json.loads(data[0])
    sol = Solution()
    print(sol.lengthOfLIS(nums))


if __name__ == "__main__":
    main()
