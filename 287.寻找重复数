"""
【寻找重复数 - 快慢指针（Floyd 判圈算法）】

思路（简洁）：
将数组视为链表：下标 i 指向 nums[i]。由于存在重复数字，必然形成环。
用快慢指针找到相遇点，然后从头开始和慢指针同步走，相遇点即为环入口，也就是重复数字。

易错点：
1. 快慢指针初始都从 0 开始（不能从 nums[0] 开始，否则可能错过）。
2. 快指针每次走两步：fast = nums[nums[fast]]。
3. 找到相遇点后，慢指针留在相遇点，新指针 head 从 0 开始，同步走直到相遇。
4. 返回相遇时的值，即重复数字。
5. 数组长度至少为 2，且元素范围在 1..n 之间。

时空复杂度：
- 时间复杂度 O(n)，快慢指针相遇和找环入口都是线性时间。
- 空间复杂度 O(1)，只用两个指针。

输入输出示例：
示例 1：
输入: [1,3,4,2,2]
输出: 2

示例 2：
输入: [3,1,3,4,2]
输出: 3

示例 3：
输入: [1,1]
输出: 1
"""

import sys
import json
from typing import List


class Solution:
    def findDuplicate(self, nums: List[int]) -> int:
        slow = fast = 0
        # 第一阶段：找到快慢指针相遇点
        while True:
            slow = nums[slow]
            fast = nums[nums[fast]]
            if fast == slow:
                break
        # 第二阶段：找到环的入口，即重复数字
        head = 0
        while slow != head:
            slow = nums[slow]
            head = nums[head]
        return slow


def main():
    # 输入为一行 JSON 数组，如 [1,3,4,2,2]
    data = sys.stdin.read().split()
    if not data:
        return
    nums = json.loads(data[0])
    sol = Solution()
    print(sol.findDuplicate(nums))


if __name__ == "__main__":
    main()
